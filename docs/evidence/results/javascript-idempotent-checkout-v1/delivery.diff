+test("duplicate keyed submissions replay the same receipt without decrementing twice", () => {
+  const inventory = new Inventory({ green: 4 });
+  const checkout = new CheckoutService(inventory);
+
+  const first = checkout.submit({ sku: "green", quantity: 2, idempotencyKey: "order-1" });
+  const duplicate = checkout.submit({ sku: "green", quantity: 2, idempotencyKey: "order-1" });
+
+  assert.strictEqual(duplicate, first);
+  assert.deepEqual(duplicate, { sku: "green", quantity: 2, remaining: 2 });
+  assert.equal(formatReceipt(duplicate), '{"sku":"green","quantity":2,"remaining":2}');
+  assert.equal(inventory.available("green"), 2);
+});
+
+test("checkout accepts the Idempotency-Key header spelling", () => {
+  const checkout = new CheckoutService(new Inventory({ green: 2 }));
+
+  assert.deepEqual(checkout.submit({ sku: "green", quantity: 1, "Idempotency-Key": "header-1" }), {
+    sku: "green",
+    quantity: 1,
+    remaining: 1,
+  });
+});
+
