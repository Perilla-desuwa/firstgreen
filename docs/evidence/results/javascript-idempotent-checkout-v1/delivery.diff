diff --git a/src/checkout.js b/src/checkout.js
index 4aa777c..1f4f216 100644
--- a/src/checkout.js
+++ b/src/checkout.js
@@ -1,14 +1,38 @@
+/**
+ * Formats a checkout result in a stable, machine-readable representation.
+ * The field order is part of the receipt's canonical form.
+ */
+export function formatReceipt({ sku, quantity, remaining }) {
+  return JSON.stringify({ sku, quantity, remaining });
+}
+
 export class CheckoutService {
+  #successfulSubmissions = new Map();
+
   constructor(inventory) {
     this.inventory = inventory;
   }
 
-  submit({ sku, quantity }) {
+  submit({ sku, quantity, idempotencyKey, "Idempotency-Key": headerKey } = {}) {
+    const suppliedKey = idempotencyKey ?? headerKey;
+    if (typeof suppliedKey !== "string" || suppliedKey.trim().length === 0) {
+      throw new TypeError("Idempotency-Key must be a non-empty string");
+    }
+
+    const previous = this.#successfulSubmissions.get(suppliedKey);
+    if (previous) {
+      return previous;
+    }
+
     if (typeof sku !== "string" || sku.length === 0) {
       throw new TypeError("sku must be a non-empty string");
     }
 
     const remaining = this.inventory.decrement(sku, quantity);
-    return { sku, quantity, remaining };
+    const receipt = { sku, quantity, remaining };
+    // Store only after all validation and mutation succeeds. Returning this same
+    // object on replay also preserves the canonical receipt identity.
+    this.#successfulSubmissions.set(suppliedKey, receipt);
+    return receipt;
   }
 }
