   const checkout = new CheckoutService(new Inventory({ green: 4 }));
 
-  assert.throws(() => checkout.submit({ sku: "", quantity: 1 }), /non-empty string/);
+  assert.throws(() => checkout.submit({ sku: "", quantity: 1, idempotencyKey: "invalid-sku" }), /non-empty string/);
+});
+
+test("checkout rejects missing and invalid Idempotency-Key values", () => {
+  const checkout = new CheckoutService(new Inventory({ green: 4 }));
+
+  assert.throws(() => checkout.submit({ sku: "green", quantity: 1 }), /Idempotency-Key/);
+  assert.throws(() => checkout.submit({ sku: "green", quantity: 1, idempotencyKey: "" }), /Idempotency-Key/);
+  assert.throws(() => checkout.submit({ sku: "green", quantity: 1, idempotencyKey: "   " }), /Idempotency-Key/);
+  assert.throws(() => checkout.submit({ sku: "green", quantity: 1, idempotencyKey: 42 }), /Idempotency-Key/);
 });
