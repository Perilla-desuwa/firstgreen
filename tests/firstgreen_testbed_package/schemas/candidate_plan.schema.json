{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["decision", "recommended_parallelism", "tasks"],
  "properties": {
    "decision": {"enum": ["single_task", "decompose"]},
    "recommended_parallelism": {"type": "integer", "minimum": 1, "maximum": 8},
    "reason": {"type": "string"},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "objective", "produces", "requires", "likely_paths", "verification_hints", "risk_tags"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "objective": {"type": "string", "minLength": 1},
          "produces": {"type": "array", "items": {"type": "string"}},
          "requires": {"type": "array", "items": {"type": "string"}},
          "likely_paths": {"type": "array", "items": {"type": "string"}},
          "verification_hints": {"type": "array", "items": {"type": "string"}},
          "risk_tags": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
